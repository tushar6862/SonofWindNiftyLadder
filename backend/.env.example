# Copy to backend/.env and fill in values
# Live LTP SSE: coalesce ms (default 16). Set 0 for max tick rate (higher CPU).
# XTS_MD_COALESCE_MS=16
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MORNING_SENTIMENT_SCHEDULE=08:00

# Fyers LIVE LTP only (rest stays on XTS). Token is daily — use Connect Fyers in TopBar.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:5174
FYERS_LTP=1
